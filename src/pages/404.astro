---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
---

<BaseLayout title="Camino perdido — Kudasai" noindex>
  <main id="contenido" class="not-found">
    <p class="eyebrow">404 · FUERA DEL CAMINO</p>
    <h1>
      Hasta los mejores
      <br />
      viajeros se pierden.
    </h1>
    <a class="button button-primary" href="/">
      Volver a Kudasai <span aria-hidden="true">↗</span>
    </a>
    <ThemeToggle />
  </main>
</BaseLayout>
