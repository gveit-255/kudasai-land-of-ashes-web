<dialog class="lightbox" aria-labelledby="lightbox-title" aria-describedby="media-status">
  <div class="lightbox-top">
    <h3 id="lightbox-title"></h3>
    <button type="button" class="lightbox-close" aria-label="Cerrar imagen">
      Cerrar <span aria-hidden="true">×</span>
    </button>
  </div>
  <img class="lightbox-image" alt="" width="1280" height="720" />
  <p class="media-status" id="media-status" data-media-status role="status"></p>
  <div class="lightbox-bottom">
    <span>El mundo de Kudasai</span>
  </div>
</dialog>
