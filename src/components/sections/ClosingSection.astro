---
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import '@/components/layout/footer.css';
---

<section class="closing" id="estado" aria-labelledby="closing-title">
  <ResponsiveImage name="forest" art sizes="100vw" alt="" />
  <div class="closing-shade"></div>
  <div class="closing-copy">
    <p class="eyebrow">
      <span class="status-dot" aria-hidden="true"></span> EN DESARROLLO
    </p>
    <h2 id="closing-title">
      Esta historia
      <br />
      <em>apenas comienza.</em>
    </h2>
    <p>
      Kudasai: Land of Ashes sigue tomando forma.
      <br />
      Mientras tanto, lleva un fragmento de su mundo contigo.
    </p>
    <a
      class="button button-primary"
      href="/media/forest-wallpaper.jpg"
      download="Kudasai-Loussiana-Wallpaper.jpg"
    >
      Descargar fondo de pantalla <span aria-hidden="true">↓</span>
    </a>
    <p class="download-note">ILUSTRACIÓN ORIGINAL · JPG · 1536 × 1024</p>
  </div>
</section>
