{
  "name": "kudasai-official-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs && node scripts/verify-demo.mjs && node scripts/verify-performance.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run check && npm run build && npm run verify",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run validate && wrangler pages deploy dist",
    "demo:export": "node scripts/export-demo.mjs"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
